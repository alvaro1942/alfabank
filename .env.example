# Alfa bank — variables de entorno. Copia este archivo a .env.local y completa los valores.
# NUNCA subas .env / .env.local al repositorio.

# Base de datos PostgreSQL PROPIA de Alfa bank (no reutilices la de otro proyecto).
DATABASE_URL="postgresql://usuario:contrasena@host:5432/alfa_bank?sslmode=require"

# Clave para firmar sesiones (obligatoria en producción). Genera una con: openssl rand -base64 48
JWT_SECRET=""

# (Opcional) Token de Vercel Blob para guardar la identificación subida en el registro.
# Sin él, el registro sigue funcionando únicamente si el usuario no adjunta archivo.
BLOB_READ_WRITE_TOKEN=""

# (Opcional) Número de soporte por WhatsApp, solo dígitos con lada de país. Si se deja vacío, el botón de soporte no aparece.
NEXT_PUBLIC_SUPPORT_WHATSAPP=""

# (Opcional) Dominios extra para Server Actions, separados por coma. Ej: "alfabank.midominio.com"
ALLOWED_ORIGINS=""

# Solo para el script `npm run create-admin` (primer administrador).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
